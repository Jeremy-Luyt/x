# Local diagnostics and lazily rendered PDF images can contain machine/lab details.
diagnostics/*
!diagnostics/.gitkeep
screenshots/pdf_cache/*
!screenshots/pdf_cache/.gitkeep

# Local environments, Python cache, and PyInstaller outputs.
.venv/
__pycache__/
*.py[cod]
build/
dist/
*.spec.bak

# Personal PDF/configuration locations are not shared.
config/config.json
data/progress.json
assets/*.pdf
